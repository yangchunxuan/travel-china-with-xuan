# Homeground frontend (public values embedded in the static site)
# Keep the form disabled until the real API, privacy notice and monitored inbox
# have passed the end-to-end receipt test.
NEXT_PUBLIC_HOMEGROUND_INQUIRY_ENABLED=false
# Independent fail-closed gate for the homepage email-only contact path.
# Enable only after its migration and Edge Function pass the end-to-end
# saved-reference and monitored-inbox test.
NEXT_PUBLIC_HOMEGROUND_HOMEPAGE_EMAIL_ENABLED=false
NEXT_PUBLIC_HOMEGROUND_INQUIRY_API_URL=https://<project-ref>.supabase.co/functions/v1/v1-inquiries
# Optional emergency fallback after a confirmed non-save. If configured, it
# must point to the same monitored inbox as BRAND_NOTIFICATION_EMAIL below.
NEXT_PUBLIC_HOMEGROUND_BRAND_EMAIL=studio@example.test
NEXT_PUBLIC_HOMEGROUND_PRIVACY_READY=false
NEXT_PUBLIC_HOMEGROUND_PRIVACY_NOTICE_URL=/privacy/
NEXT_PUBLIC_HOMEGROUND_PRIVACY_NOTICE_URL_EN=/privacy/
NEXT_PUBLIC_HOMEGROUND_PRIVACY_NOTICE_URL_ZH=/zh/privacy/
NEXT_PUBLIC_HOMEGROUND_PRIVACY_NOTICE_URL_KO=/ko/privacy/
# Localized duration fragments only; the UI supplies "within / 内 / 이내".
NEXT_PUBLIC_HOMEGROUND_REPLY_SLA_EN=48 hours
NEXT_PUBLIC_HOMEGROUND_REPLY_SLA_ZH=48 小时
NEXT_PUBLIC_HOMEGROUND_REPLY_SLA_KO=48시간
# Public switch for saving a traveller's WhatsApp number through the same
# secure enquiry service as email. Enable only after the backend path is live.
NEXT_PUBLIC_HOMEGROUND_WHATSAPP_INTAKE_ENABLED=false
# Homepage direct contact links. These are public brand contact details, not
# visitor data. Set the switch to false for an immediate build-time disable.
NEXT_PUBLIC_HOMEGROUND_DIRECT_WHATSAPP_ENABLED=true
NEXT_PUBLIC_HOMEGROUND_WHATSAPP_NUMBER=8613174215999
NEXT_PUBLIC_HOMEGROUND_MESSENGER_URL=https://m.me/61591910731724
NEXT_PUBLIC_HOMEGROUND_FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=61591910731724

# Consent-gated website measurement. All four public values are fail-closed:
# analytics stays completely off unless the shared switch is true, the relevant
# identifier/endpoint is valid, and the visitor has granted that category.
NEXT_PUBLIC_HOMEGROUND_ANALYTICS_ENABLED=false
NEXT_PUBLIC_HOMEGROUND_GA4_MEASUREMENT_ID=G-DPGR2SVC0G
NEXT_PUBLIC_HOMEGROUND_META_PIXEL_ID=1049980710767613
NEXT_PUBLIC_HOMEGROUND_WEB_EVENTS_URL=https://xbymvlxethfzqcgyoieb.supabase.co/functions/v1/v1-traffic-events

# Homeground private saved-inquiry insights page (public build-time values)
# These values identify the Supabase project and its two authenticated Edge
# endpoints. They are intentionally public; never place a secret/service-role
# key or an administrator UUID in any NEXT_PUBLIC variable.
NEXT_PUBLIC_HOMEGROUND_ADMIN_SUPABASE_URL=https://xbymvlxethfzqcgyoieb.supabase.co
NEXT_PUBLIC_HOMEGROUND_ADMIN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0xCb0Oh_WNZHpeqx7t2P_A_h2iFFOGx
NEXT_PUBLIC_HOMEGROUND_ADMIN_INSIGHTS_URL=https://xbymvlxethfzqcgyoieb.supabase.co/functions/v1/admin-insights
NEXT_PUBLIC_HOMEGROUND_ADMIN_HEALTH_URL=https://xbymvlxethfzqcgyoieb.supabase.co/functions/v1/admin-health
NEXT_PUBLIC_HOMEGROUND_ADMIN_TRAFFIC_URL=https://xbymvlxethfzqcgyoieb.supabase.co/functions/v1/admin-traffic

# Supabase Edge Function: v1-inquiries (server-only)
SUPABASE_URL=https://<project-ref>.supabase.co
# Hosted Edge Functions inject the new JSON dictionary automatically. The code
# reads its "default" secret key and falls back to the legacy key while Supabase
# still provides it. These placeholders are only for local function serving;
# do not try to override either hosted default.
SUPABASE_SECRET_KEYS={"default":"<server-only-supabase-secret-key>"}
SUPABASE_SERVICE_ROLE_KEY=<legacy-server-only-service-role-key>
ALLOWED_ORIGINS=https://<production-origin>
# Safe steady-state allow-list. Older paired versions may be added only for a
# documented, bounded static-rollout overlap and must then be removed again.
ALLOWED_FORM_VERSIONS=2026-07-21.1,2026-07-26.1
ALLOWED_PRIVACY_NOTICE_VERSIONS=2026-07-21.1,2026-07-26.1
# Emergency server-side kill switch. Setting this to false stops direct API
# submissions before their request bodies are read; the static frontend switch
# alone cannot stop a caller who already knows the public endpoint.
INQUIRY_ACCEPTING_SUBMISSIONS=true
# Server-side saved-phone intake switch. It is independent from the public
# frontend switch so the API can be closed before the static site is rebuilt.
WHATSAPP_ENABLED=false
IDEMPOTENCY_HASH_SECRET=<independent-high-entropy-secret>
RATE_LIMIT_HASH_SECRET=<different-high-entropy-secret>
RATE_LIMIT_10_MINUTES=5
RATE_LIMIT_24_HOURS=20
REPLY_SLA_HOURS=48

# Supabase Edge Function: v1-traffic-events (server-only)
# Public analytics requests are rejected before parsing unless this switch is
# explicitly true. Use a different HMAC secret from every inquiry/admin secret.
TRAFFIC_EVENTS_ENABLED=false
TRAFFIC_SESSION_HASH_SECRET=<independent-high-entropy-secret>
TRAFFIC_RATE_LIMIT_HASH_SECRET=<different-high-entropy-secret>
# Short-lived credentials stop the write endpoint from accepting bare,
# fabricated browser payloads. This must not match either hash secret.
TRAFFIC_SESSION_CREDENTIAL_SECRET=<different-high-entropy-secret>
TRAFFIC_SESSION_CREDENTIAL_TTL_SECONDS=1800
# Only links signed with this separate server secret can contribute UTM
# source/campaign labels. Unsigned or edited UTM values remain Unknown.
TRAFFIC_ATTRIBUTION_LINK_SIGNING_SECRET=<different-high-entropy-secret>
# Limits count newly accepted events (not HTTP requests) and are enforced
# simultaneously per browser session, client IP and the whole low-traffic site.
TRAFFIC_SESSION_RATE_LIMIT_10_MINUTES=30
TRAFFIC_SESSION_RATE_LIMIT_24_HOURS=120
TRAFFIC_IP_RATE_LIMIT_10_MINUTES=60
TRAFFIC_IP_RATE_LIMIT_24_HOURS=300
TRAFFIC_GLOBAL_RATE_LIMIT_10_MINUTES=200
TRAFFIC_GLOBAL_RATE_LIMIT_24_HOURS=2000

# Supabase Edge Function: notify-inquiries (server-only)
NOTIFICATION_WORKER_SECRET=<high-entropy-worker-secret>
# Emergency queue pause. New outbox rows remain stored and unsent until this
# returns to true; pause intake first so the queue cannot keep growing.
NOTIFICATION_PROCESSING_ENABLED=true
RESEND_API_KEY=<server-only-resend-api-key>
RESEND_FROM_EMAIL="Homeground <notifications@example.test>"
BRAND_NOTIFICATION_EMAIL=studio@example.test
NOTIFICATION_BATCH_SIZE=1
NOTIFICATION_LEASE_SECONDS=90
NOTIFICATION_PROVIDER_TIMEOUT_SECONDS=15

# Supabase Edge Function: inquiry-health (server-only)
# Use a different value from NOTIFICATION_WORKER_SECRET and RESEND_API_KEY.
OUTBOX_MONITOR_SECRET=<independent-high-entropy-monitor-secret>
# Non-PII traffic alert thresholds used by inquiry-health. Reaching a threshold
# makes the independent GitHub monitor fail so a person can pause intake.
INQUIRY_ALERT_10_MINUTES=10
INQUIRY_ALERT_1_HOUR=30
INQUIRY_ALERT_24_HOURS=100

# GitHub Actions repository variable. GitHub Actions stores the matching
# OUTBOX_MONITOR_SECRET value as an Actions secret, not a repository variable.
OUTBOX_HEALTH_URL=https://<project-ref>.supabase.co/functions/v1/inquiry-health

# Supabase Edge Functions: admin-insights and admin-health (server-only)
# Hosted Supabase injects its project URL and key dictionaries. The values
# below document the local/server contract only.
SUPABASE_PUBLISHABLE_KEYS={"default":"<sb_publishable_public_key>"}
SUPABASE_PUBLISHABLE_KEY=<local-single-publishable-key-fallback>
# Legacy fallback only when the project has not migrated to publishable keys.
SUPABASE_ANON_KEY=<legacy-anon-key>
# One exact HTTPS website origin in production; no path and no wildcard.
ADMIN_ALLOWED_ORIGIN=https://homegroundchina.com
# Server-side kill switch. Missing or false keeps both Admin data GETs closed.
ADMIN_API_ENABLED=false
# Independent kill switch for the consented, anonymous website-traffic view.
ADMIN_TRAFFIC_API_ENABLED=false
# Comma-separated Supabase Auth user UUIDs. This is server-only authorization,
# not an email-address allow-list.
ADMIN_ALLOWED_USER_IDS=<admin-auth-user-uuid>
ADMIN_ENVIRONMENT=production
# Accepted user JWT lifetime ceiling in seconds (300–7200).
ADMIN_MAX_TOKEN_LIFETIME_SECONDS=3600

# Scheduler values are stored separately in Supabase Vault, never in the
# frontend or repository. See docs/inquiry-deployment.md:
# - homeground_notification_worker_url
# - homeground_notification_worker_secret (same value as the worker env above)

# PUBLIC WEBSITE CONFIGURATION ONLY. Never add credentials or server secrets.
# Read by Next.js for production builds; the existing analytics master switch,
# production-host check, and current marketing consent are still required.
# This stores eligible ad clicks with inquiries; it starts no ads or uploads.
NEXT_PUBLIC_HOMEGROUND_AD_ATTRIBUTION_ENABLED=true
# No Google Ads browser tag until the real account setup is completed.
NEXT_PUBLIC_HOMEGROUND_GOOGLE_ADS_ID=

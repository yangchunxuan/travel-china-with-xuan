    "en": {
      "full-trip-support": {
        "label": "Existing planning service",
        "title": "Need this stay choice checked in the full route?",
        "body": "Full Trip Planning & Ground Support can include this stay decision within a written scope and custom quote. It does not promise live rooms, a fixed hotel price or guest acceptance.",
        "button": "See scoped full-trip support"
      },
      "itinerary-review": {
        "label": "Existing itinerary service",
        "title": "Already have a day-by-day route?",
        "body": "Review My Route checks this connection in the context of your existing itinerary. It does not book transport, supply a vehicle or guarantee a pickup, ticket or timetable.",
        "button": "See the itinerary review scope"
      }
    },
    "zh": {
      "full-trip-support": {
        "label": "现有规划服务",
        "title": "需要把住宿选择放进整段路线核对吗？",
        "body": "整段旅行规划与落地支持可在书面范围和定制报价内处理这项住宿决策，但不承诺实时房态、固定酒店价格或一定接待外宾。",
        "button": "查看整段旅行支持范围"
      },
      "itinerary-review": {
        "label": "现有行程服务",
        "title": "已经有逐日行程了吗？",
        "body": "行程复核会把这段衔接放回你已有的整条路线检查，但不代订交通、不提供车辆，也不保证接送点、票务或时刻表。",
        "button": "查看行程复核范围"
      }
    },
    "ko": {
      "full-trip-support": {
        "label": "현재 제공 중인 여행 설계 서비스",
        "title": "숙소 선택을 전체 동선과 함께 점검할까요?",
        "body": "전체 여행 설계 및 현지 지원은 서면 범위와 맞춤 견적 안에서 이 숙소 선택을 함께 검토할 수 있습니다. 실시간 객실 재고나 예약 가능 여부, 고정 객실 요금 또는 외국인 투숙 가능 여부를 보장하지 않습니다.",
        "button": "전체 여행 지원 범위 보기"
      },
      "itinerary-review": {
        "label": "현재 제공 중인 일정 서비스",
        "title": "이미 날짜별 일정이 있나요?",
        "body": "일정 검토는 기존 전체 동선 안에서 이 연결을 점검합니다. 교통편을 대신 예약하거나 차량을 제공하는 서비스가 아니며, 픽업 장소·시간, 교통편 티켓 또는 운행 시간표를 보장하지 않습니다.",
        "button": "일정 검토 범위 보기"
      }
    }
  },

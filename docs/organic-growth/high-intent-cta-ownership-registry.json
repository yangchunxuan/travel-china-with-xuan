  "forbiddenClaimDefinitions": {
    "automatic-or-instant-result": "Do not promise an automatic, instant or no-human-review result.",
    "paid-work-before-scope-payment": "Do not imply that paid work starts before scope, delivery timing and payment are confirmed.",
    "guaranteed-booking-or-availability": "Do not guarantee a booking, inventory, price or supplier availability.",
    "unscoped-ground-support": "Do not imply that ground support is included before a written scope and custom quote are confirmed.",
    "hotel-real-time-availability": "Do not claim real-time hotel or room availability.",
    "hotel-guest-acceptance-guarantee": "Do not guarantee that a property will accept a foreign guest.",
    "hotel-price-room-guarantee": "Do not guarantee a hotel price, room type, accessibility feature or property condition.",
    "vehicle-driver-availability-guarantee": "Do not guarantee a vehicle, driver or transfer slot.",
    "fixed-transfer-price-or-pickup-guarantee": "Do not promise a fixed transfer price, pickup point or pickup time without confirmation.",
    "transport-includes-entry-tickets": "Do not imply that transport includes attraction admission, shuttles or uphill access tickets.",
    "ticket-availability-price-guarantee": "Do not claim live ticket inventory or a guaranteed ticket price.",
    "booking-entry-guarantee": "Do not promise successful booking or entry.",
    "reseller-official-equivalence": "Do not describe a reseller as equivalent to an official issuer or channel.",
    "sensitive-data-first-contact": "Do not request passport images, payment data or unredacted booking references in the first contact."
  },

      "expected": {"status": "invalid", "decisionUseful": false, "errors": [{"field": "arrivalWindow", "code": "UNSUPPORTED_TIME_WINDOW"}], "result": null}
    },
    {
      "id": "HANDOFF-01",
      "group": "handoff-routing",
      "question": "Open-jaw gateways or a return to the arrival airport?",
      "input": {"totalNights": 8, "arrivalWindow": "12_15", "departureWindow": "15_18", "crossCityMoves": 2, "airportStationTransfers": 1, "hotelChanges": 0, "travellerPace": "balanced"},
      "comparisonInput": {"totalNights": 8, "arrivalWindow": "12_15", "departureWindow": "15_18", "crossCityMoves": 3, "airportStationTransfers": 2, "hotelChanges": 0, "travellerPace": "balanced"},
      "expectedProperty": "The model may compare two independently validated skeletons only after an upstream owner defines them. It cannot identify airports, find flights, label either input open-jaw, or recommend a gateway."
    },
    {
      "id": "HANDOFF-02",
      "group": "handoff-routing",
      "question": "Does a fixed attraction booking conflict with an arrival or relocation?",
      "input": {"totalNights": 5, "arrivalWindow": "15_18", "departureWindow": "after_18", "crossCityMoves": 1, "airportStationTransfers": 0, "hotelChanges": 0, "travellerPace": "balanced"},
      "expectedProperty": "The seven fields contain no booking date, sequence, refund rule or consequence. Return no conflict claim; route the question to the Plan constraint ledger and the relevant arrival-day, ticket or venue owner."
    },
    {
      "id": "HANDOFF-03",
      "group": "handoff-routing",
      "question": "Do consecutive difficult days create a fatigue chain?",
      "input": {"totalNights": 6, "arrivalWindow": "after_18", "departureWindow": "before_09", "crossCityMoves": 2, "airportStationTransfers": 2, "hotelChanges": 1, "travellerPace": "slow"},
      "expectedProperty": "Aggregate counts can support a possible density alert only after policy approval. They do not encode event sequence or health and cannot confirm fatigue; route that judgment to the traveller-fit owner or human review."

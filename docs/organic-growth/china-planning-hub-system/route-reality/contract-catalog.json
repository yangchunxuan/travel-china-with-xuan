{
  "contractVersion": "route-reality-v3.0.0-internal-draft",
  "requestSchemaId": "urn:homeground:route-reality:v3:request",
  "draftOutcomeSchemaId": "urn:homeground:route-reality:v3:draft-outcome",
  "policyPackVersion": null,
  "requestFields": [

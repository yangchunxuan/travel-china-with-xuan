    "PolicyPendingOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "terminalState",
        "modelVersion",
        "policyPackVersion",
        "terminalReason",
        "decisionUseful",
        "errors",
        "inputState",
        "uncertaintyState",
        "uncertainties",
        "assumptions",
        "result",
        "publicImplementationAuthorized",
        "indexablePageAuthorized"
      ],
      "properties": {
        "status": {
          "const": "policy_pending"
        },
        "terminalState": {
          "enum": [
            "policy_pending_fully_known_unique_placement",
            "policy_pending_fully_known_placement_unresolved",
            "policy_pending_input_unresolved",
            "policy_pending_input_and_placement_unresolved"
          ]
        },
        "modelVersion": {
          "$ref": "#/$defs/ModelVersion"
        },
        "policyPackVersion": {
          "$ref": "#/$defs/PendingPolicyPackVersion"
        },
        "terminalReason": {
          "const": "NUMERIC_POLICY_PACK_NOT_APPROVED"
        },
        "decisionUseful": {
          "const": false
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        },
        "inputState": {
          "enum": [
            "fully_known",
            "contains_unknown"
          ]
        },
        "uncertaintyState": {
          "enum": [
            "none",
            "input_unresolved",
            "placement_unresolved",
            "input_and_placement_unresolved"
          ]
        },
        "uncertainties": {
          "type": "array",
          "uniqueItems": true,
          "items": {}
        },
        "assumptions": {
          "$ref": "#/$defs/Assumptions"
        },
        "result": {
          "type": "null"
        },
        "publicImplementationAuthorized": {
          "const": false
        },
        "indexablePageAuthorized": {
          "const": false
        }

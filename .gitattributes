# Download checksums are part of the public asset contract. Keep text payloads
# byte-identical on Windows, macOS and Linux checkouts.
public/downloads/*.txt text eol=lf
public/downloads/*.csv text eol=lf
public/downloads/*.json text eol=lf
public/downloads/*.svg text eol=lf

# The serif slice stylesheet is named after a hash of its bytes; keep them
# identical on every checkout.
public/fonts/*.css text eol=lf
